# Copy to .env.local for local dev, and add the same two values in Vercel → Project → Settings → Environment Variables.
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Remix breakdowns (server-side only — never prefixed with VITE_). https://platform.claude.com → API keys
ANTHROPIC_API_KEY=sk-ant-...
